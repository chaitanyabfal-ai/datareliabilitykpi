# Copy this file to .env and fill in real values. Never commit .env.

## --- Syncthing / local ingestion --------------------------------------
SYNC_WATCH_DIR=/path/to/syncthing/local/folder
SYNC_IGNORE_SUFFIXES=.tmp,.part,.swp
SYNC_SETTLE_SECONDS=0.5
DELETE_AFTER_UPLOAD=true
UPLOAD_TARGET=aws

## --- Garage S3 (over Tailscale) ----------------------------------------
# Optional legacy staging target. Default direct AWS upload is preferred.
GARAGE_ENDPOINT_URL=http://100.84.7.71:3900/
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=
GARAGE_BUCKET=sensor-data-staging
GARAGE_REGION=garage

## --- AWS ----------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_RAW_BUCKET=raw-sensor-data-bucket
AWS_RAW_PREFIX=raw-sensor-data/
SNS_TOPIC_ARN=
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_MAX_MESSAGES=10
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=60

# Standard AWS credential env vars also work if you're not using an
# instance role: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN

## --- KPI configuration ---------------------------------------------------
# Comma-separated "sensor_id:min:max" triples. Values outside range count
# as a threshold breach for that sensor.
KPI_THRESHOLDS=
KPI_HOURLY_ALIGN_MINUTES=60

## --- Data-reliability (uptime/downtime) configuration --------------------
# All reliability KPI logic is rule-based -- no machine learning is used.

# Expected per-sensor cadence in seconds (default for every sensor).
RELIABILITY_EXPECTED_FREQUENCY_SECONDS=300
# Per-sensor cadence overrides: "BFA8:300,BFA3:300"
RELIABILITY_SENSOR_CADENCES=

# Timestamp consonance: max acceptable delay (sensor_ts vs ingestion_ts).
RELIABILITY_MAX_DELAY_SECONDS=60

# Heartbeat: no data within this many seconds => sensor considered down.
RELIABILITY_HEARTBEAT_SECONDS=600

# Rolling-window uptime: window size + averaging horizon (hours).
RELIABILITY_UPTIME_WINDOW_SECONDS=3600
RELIABILITY_UPTIME_ROLLING_HORIZON_HOURS=24

# Data-quality bounds: only in-range records count toward uptime.
# Format: "BFA8:0:100,BFA3:0:100"
RELIABILITY_QUALITY_BOUNDS=

# Multi-sensor correlation groups (sensors monitoring the same segment).
# Groups separated by ';', members by ','. e.g. "BFA8,BFA3;LINE2A,LINE2B"
RELIABILITY_CORRELATION_GROUPS=

# Downtime buckets for uptime-with-exclusions (comma-separated cause lists).
RELIABILITY_PLANNED_CAUSES=Operational Maintenance,Pigging Operation,Valve Operation,Sensor Recalibration
RELIABILITY_UNCONTROLLABLE_CAUSES=Airtel LTE Outage,Extreme Weather,Temperature Extremes,DDoS Attack,Earthquake

# Hardware telemetry thresholds that flag degradation.
RELIABILITY_MIN_BATTERY_PERCENT=20
RELIABILITY_MIN_SIGNAL_STRENGTH=10

# Sensor locations for Airtel/weather detectors. Format: "BFA8:28.19,76.61,Rewari"
RELIABILITY_SENSOR_LOCATIONS=

## --- External cause detectors (all OFFLINE / disabled by default) -------
# Each is guarded behind an *_ENABLED flag; when disabled the detector
# returns "unknown" and never touches the network, so the pipeline runs
# offline by default.

# Airtel LTE outage API
AIRTEL_OUTAGE_API_ENABLED=false
AIRTEL_OUTAGE_API_URL=
AIRTEL_OUTAGE_API_TOKEN=

# Weather (e.g. OpenWeatherMap) for the environmental detector
WEATHER_API_ENABLED=false
WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather
WEATHER_API_KEY=

# SCADA system for valve/pigging/ESD detection
SCADA_API_ENABLED=false
SCADA_API_URL=

# Pipeline health (SQS backlog, S3 latency) checks
PIPELINE_HEALTH_ENABLED=false
PIPELINE_SQS_BACKLOG_THRESHOLD=1000
PIPELINE_S3_LATENCY_THRESHOLD_SECONDS=30

## --- Paths (override only if you need a non-default layout) -------------
DATA_DIR=
LOG_DIR=
KPI_REPORTS_DIR=
MAINTENANCE_DIR=
CAUSE_LOG_PATH=
