[Unit]
Description=Garage Uploader (Syncthing folder -> Garage S3)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=sensoruser
WorkingDirectory=/opt/kpidatareporttf
EnvironmentFile=/opt/kpidatareporttf/.env
ExecStart=/usr/bin/python3 /opt/kpidatareporttf/scripts/garage_uploader.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
